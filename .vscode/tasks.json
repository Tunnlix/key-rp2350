            "windows": {
                "command": "${env:LOCALAPPDATA}/Microsoft/WinGet/Packages/BrechtSanders.WinLibs.POSIX.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/mingw64/bin/gcc.exe",
                "args": ["-std=c17", "-Wall", "-Wextra", "-Wpedantic", "-g", "-O0", "-I", "${workspaceFolder}/include", "${workspaceFolder}/examples/host/main.c", "${workspaceFolder}/src/protocol/ctaphid_parser.c", "${workspaceFolder}/src/protocol/ctaphid_reassembler.c", "${workspaceFolder}/src/protocol/ctaphid_dispatcher.c", "${workspaceFolder}/src/protocol/ctaphid_handlers.c", "${workspaceFolder}/src/protocol/ctaphid_response.c", "${workspaceFolder}/src/protocol/ctaphid_channels.c", "-o", "${workspaceFolder}/main.exe"]
