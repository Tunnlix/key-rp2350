{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C program",
      "type": "process",
      "command": "gcc",
      "args": [
        "-std=c17",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-g",
        "-O0",
        "-I",
        "${workspaceFolder}/include",
        "${workspaceFolder}/examples/host/host_actions.c",
        "${workspaceFolder}/examples/host/host_clock.c",
        "${workspaceFolder}/examples/host/host_presence.c",
        "${workspaceFolder}/examples/host/host_storage.c",
        "${workspaceFolder}/examples/host/main.c",
        "${workspaceFolder}/examples/host/pc_authenticator.c",
        "${workspaceFolder}/examples/host/stdio_transport.c",
        "${workspaceFolder}/src/protocol/ctaphid_channels.c",
        "${workspaceFolder}/src/protocol/ctaphid_ctap_backend.c",
        "${workspaceFolder}/src/protocol/ctaphid_device.c",
        "${workspaceFolder}/src/protocol/ctaphid_dispatcher.c",
        "${workspaceFolder}/src/protocol/ctaphid_handlers.c",
        "${workspaceFolder}/src/protocol/ctaphid_parser.c",
        "${workspaceFolder}/src/protocol/ctaphid_reassembler.c",
        "${workspaceFolder}/src/protocol/ctaphid_response.c",
        "${workspaceFolder}/src/ctap/cbor_reader.c",
        "${workspaceFolder}/src/ctap/ctap_attestation.c",
        "${workspaceFolder}/src/ctap/ctap_make_credential.c",
        "${workspaceFolder}/src/ctap/ctap_get_assertion.c",
        "${workspaceFolder}/src/ctap/ctap_hmac_secret.c",
        "${workspaceFolder}/src/ctap/ctap_pin_protocol.c",
        "${workspaceFolder}/src/ctap/ctap_client_pin.c",
        "${workspaceFolder}/src/ctap/ctap_request.c",
        "${workspaceFolder}/src/ctap/cbor_writer.c",
        "${workspaceFolder}/src/ctap/ctap_get_info.c",
        "${workspaceFolder}/src/ctap/ctap_reset.c",
        "${workspaceFolder}/src/ctap/ctap_user_presence.c",
        "${workspaceFolder}/src/ctap/ctap.c",
        "${workspaceFolder}/src/authenticator/auth_credentials.c",
        "${workspaceFolder}/src/authenticator/auth_es256.c",
        "${workspaceFolder}/src/authenticator/auth_platform.c",
        "${workspaceFolder}/src/authenticator/auth_secret_crypto.c",
        "${workspaceFolder}/src/authenticator/auth_pin.c",
        "-o",
        "${workspaceFolder}/main"
      ],
      "windows": {
        "command": "${env:LOCALAPPDATA}/Microsoft/WinGet/Packages/BrechtSanders.WinLibs.POSIX.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/mingw64/bin/gcc.exe",
        "args": [
          "-std=c17",
          "-Wall",
          "-Wextra",
          "-Wpedantic",
          "-g",
          "-O0",
          "-I",
          "${workspaceFolder}/include",
          "${workspaceFolder}/examples/host/host_actions.c",
          "${workspaceFolder}/examples/host/host_clock.c",
          "${workspaceFolder}/examples/host/host_presence.c",
          "${workspaceFolder}/examples/host/host_storage.c",
          "${workspaceFolder}/examples/host/main.c",
          "${workspaceFolder}/examples/host/pc_authenticator.c",
          "${workspaceFolder}/examples/host/stdio_transport.c",
          "${workspaceFolder}/src/protocol/ctaphid_channels.c",
          "${workspaceFolder}/src/protocol/ctaphid_ctap_backend.c",
          "${workspaceFolder}/src/protocol/ctaphid_device.c",
          "${workspaceFolder}/src/protocol/ctaphid_dispatcher.c",
          "${workspaceFolder}/src/protocol/ctaphid_handlers.c",
          "${workspaceFolder}/src/protocol/ctaphid_parser.c",
          "${workspaceFolder}/src/protocol/ctaphid_reassembler.c",
          "${workspaceFolder}/src/protocol/ctaphid_response.c",
          "${workspaceFolder}/src/ctap/cbor_reader.c",
          "${workspaceFolder}/src/ctap/ctap_attestation.c",
          "${workspaceFolder}/src/ctap/ctap_make_credential.c",
          "${workspaceFolder}/src/ctap/ctap_get_assertion.c",
          "${workspaceFolder}/src/ctap/ctap_hmac_secret.c",
          "${workspaceFolder}/src/ctap/ctap_pin_protocol.c",
          "${workspaceFolder}/src/ctap/ctap_client_pin.c",
          "${workspaceFolder}/src/ctap/ctap_request.c",
          "${workspaceFolder}/src/ctap/cbor_writer.c",
          "${workspaceFolder}/src/ctap/ctap_get_info.c",
          "${workspaceFolder}/src/ctap/ctap_reset.c",
          "${workspaceFolder}/src/ctap/ctap_user_presence.c",
          "${workspaceFolder}/src/ctap/ctap.c",
          "${workspaceFolder}/src/authenticator/auth_credentials.c",
          "${workspaceFolder}/src/authenticator/auth_es256.c",
          "${workspaceFolder}/src/authenticator/auth_platform.c",
          "${workspaceFolder}/src/authenticator/auth_secret_crypto.c",
          "${workspaceFolder}/src/authenticator/auth_pin.c",
          "-lbcrypt",
          "-lcrypt32",
          "-o",
          "${workspaceFolder}/main.exe"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Test python-fido2 integration",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tools/python-client",
        "-p",
        "test_*.py",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Run user presence demo",
      "type": "process",
      "command": "${workspaceFolder}/main",
      "windows": {
        "command": "${workspaceFolder}/main.exe"
      },
      "args": [
        "--presence-demo"
      ],
      "dependsOn": "Build C program",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Run authenticator reset demo",
      "type": "process",
      "command": "${workspaceFolder}/main",
      "windows": {
        "command": "${workspaceFolder}/main.exe"
      },
      "args": [
        "--reset-demo"
      ],
      "dependsOn": "Build C program",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "focus": true
      }
    }
  ]
}
