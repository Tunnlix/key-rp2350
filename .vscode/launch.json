{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C program",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/main",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Display integers and byte values in hexadecimal",
                    "text": "-gdb-set output-radix 16",
                    "ignoreFailures": false
                },
                {
                    "description": "Show complete CTAPHID report arrays",
                    "text": "-gdb-set print elements 128",
                    "ignoreFailures": false
                },
                {
                    "description": "Show repeated bytes individually",
                    "text": "-gdb-set print repeats 0",
                    "ignoreFailures": false
                },
                {
                    "description": "Format structures for easier inspection",
                    "text": "-gdb-set print pretty on",
                    "ignoreFailures": false
                }
            ],
            "miDebuggerPath": "gdb",
            "windows": {
                "program": "${workspaceFolder}/main.exe",
                "miDebuggerPath": "${env:LOCALAPPDATA}/Microsoft/WinGet/Packages/BrechtSanders.WinLibs.POSIX.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/mingw64/bin/gdb.exe"
            },
            "preLaunchTask": "Build C program"
        }
    ]
}
