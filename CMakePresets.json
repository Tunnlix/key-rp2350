{
  "version": 3,
  "configurePresets": [
    {
      "name": "native-tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}
    },
    {
      "name": "core-only",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "OFF"}
    }
  ],
  "buildPresets": [
    {"name": "native-tests", "configurePreset": "native-tests"},
    {"name": "core-only", "configurePreset": "core-only"}
  ],
  "testPresets": [
    {"name": "native-tests", "configurePreset": "native-tests", "output": {"outputOnFailure": true}}
  ]
}
