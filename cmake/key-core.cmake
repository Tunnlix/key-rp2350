include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/key-core-release.cmake")
include(FetchContent)

set(TUNNLIX_KEY_CORE_SOURCE_DIR "" CACHE PATH "Explicit development checkout of key-core")
set(TUNNLIX_KEY_CORE_ARCHIVE "" CACHE FILEPATH "Offline copy of the selected core release archive")
option(TUNNLIX_KEY_CORE_REQUIRE_RELEASE "Reject core source overrides for release builds" OFF)

if(TARGET ctap_core)
    message(FATAL_ERROR "Load key-core through this dependency module before creating ctap_core")
endif()
if(TUNNLIX_KEY_CORE_SOURCE_DIR AND TUNNLIX_KEY_CORE_ARCHIVE)
    message(FATAL_ERROR "Select either a development core checkout or an offline release archive")
endif()
if(DEFINED FETCHCONTENT_SOURCE_DIR_TUNNLIX_KEY_CORE AND
        NOT "${FETCHCONTENT_SOURCE_DIR_TUNNLIX_KEY_CORE}" STREQUAL "")
    message(FATAL_ERROR "Use TUNNLIX_KEY_CORE_SOURCE_DIR so development overrides are recorded")
endif()

if(TUNNLIX_KEY_CORE_SOURCE_DIR)
    if(TUNNLIX_KEY_CORE_REQUIRE_RELEASE)
        message(FATAL_ERROR "Release builds require the verified key-core archive; remove the source override")
    endif()
    get_filename_component(key_core_source "${TUNNLIX_KEY_CORE_SOURCE_DIR}" REALPATH BASE_DIR "${CMAKE_SOURCE_DIR}")
    if(NOT EXISTS "${key_core_source}/CMakeLists.txt")
        message(FATAL_ERROR "TUNNLIX_KEY_CORE_SOURCE_DIR must contain a key-core checkout")
    endif()
    set(key_core_mode "development-source")
    message(WARNING "Using development key-core sources: ${key_core_source}; this is not the pinned release")
    add_subdirectory("${key_core_source}" "${CMAKE_BINARY_DIR}/key-core")
else()
    set(key_core_url "${TUNNLIX_KEY_CORE_RELEASE_URL}")
    if(TUNNLIX_KEY_CORE_ARCHIVE)
        get_filename_component(key_core_url "${TUNNLIX_KEY_CORE_ARCHIVE}" REALPATH BASE_DIR "${CMAKE_SOURCE_DIR}")
        if(NOT EXISTS "${key_core_url}")
            message(FATAL_ERROR "Offline key-core archive does not exist")
        endif()
        file(SHA256 "${key_core_url}" supplied_core_sha256)
        if(NOT supplied_core_sha256 STREQUAL TUNNLIX_KEY_CORE_RELEASE_SHA256)
            message(FATAL_ERROR "Offline key-core archive SHA-256 does not match the selected release")
        endif()
    endif()
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    FetchContent_Declare(tunnlix_key_core
        URL "${key_core_url}"
        URL_HASH "SHA256=${TUNNLIX_KEY_CORE_RELEASE_SHA256}")
    FetchContent_MakeAvailable(tunnlix_key_core)
    set(key_core_source "${tunnlix_key_core_SOURCE_DIR}")
    set(key_core_mode "release-archive")
endif()

if(NOT TARGET ctap_core OR NOT TARGET Tunnlix::KeyCore)
    message(FATAL_ERROR "Selected sources do not provide the expected key-core CMake targets")
endif()
get_target_property(key_core_actual_version ctap_core TUNNLIX_KEY_CORE_VERSION)
if(key_core_mode STREQUAL "release-archive" AND
        NOT key_core_actual_version VERSION_EQUAL TUNNLIX_KEY_CORE_RELEASE_VERSION)
    message(FATAL_ERROR "Core archive version disagrees with the selected release")
endif()
set(key_core_source_commit "${TUNNLIX_KEY_CORE_RELEASE_COMMIT}")
set(key_core_source_dirty "false")
if(key_core_mode STREQUAL "development-source")
    set(key_core_source_commit "")
    set(key_core_source_dirty "null")
    find_package(Git QUIET)
    if(Git_FOUND)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${key_core_source}" rev-parse HEAD
            OUTPUT_VARIABLE local_core_commit OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE local_core_status ERROR_QUIET)
        if(local_core_status EQUAL 0 AND local_core_commit MATCHES "^[0-9a-f]+$")
            set(key_core_source_commit "${local_core_commit}")
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${key_core_source}" status --porcelain --untracked-files=no
                OUTPUT_VARIABLE local_core_changes RESULT_VARIABLE local_core_status ERROR_QUIET)
            if(local_core_status EQUAL 0)
                if(local_core_changes STREQUAL "")
                    set(key_core_source_dirty "false")
                else()
                    set(key_core_source_dirty "true")
                endif()
            endif()
        endif()
    endif()
endif()
# This file accompanies build/signing evidence; it does not change device identity.
file(WRITE "${CMAKE_BINARY_DIR}/key-core-provenance.json"
    "{\n  \"dependency_mode\": \"${key_core_mode}\",\n  \"core_version\": \"${key_core_actual_version}\",\n  \"selected_release\": \"${TUNNLIX_KEY_CORE_RELEASE_TAG}\",\n  \"selected_release_commit\": \"${TUNNLIX_KEY_CORE_RELEASE_COMMIT}\",\n  \"selected_release_sha256\": \"${TUNNLIX_KEY_CORE_RELEASE_SHA256}\",\n  \"source_commit\": \"${key_core_source_commit}\",\n  \"source_dirty\": ${key_core_source_dirty},\n  \"local_source_override\": ")
if(key_core_mode STREQUAL "development-source")
    file(APPEND "${CMAKE_BINARY_DIR}/key-core-provenance.json" "true\n}\n")
else()
    file(APPEND "${CMAKE_BINARY_DIR}/key-core-provenance.json" "false\n}\n")
endif()
message(STATUS "Tunnlix key-core: ${key_core_actual_version} (${key_core_mode})")
