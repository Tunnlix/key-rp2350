/* ROM maps either 748 KiB application slot to 0x10000000. Storage symbols are
 * physical addresses, read through the untranslated XIP alias by board_flash. */
MEMORY
{
    FLASH(rx) : ORIGIN = 0x10000000, LENGTH = 748K
    CTAP_BLOBS(r) : ORIGIN = 0x10178000, LENGTH = 32K
    CTAP_STORE(r) : ORIGIN = 0x10180000, LENGTH = 512K
}
__ctap_store_start = ORIGIN(CTAP_STORE);
__ctap_store_end = ORIGIN(CTAP_STORE) + LENGTH(CTAP_STORE);
