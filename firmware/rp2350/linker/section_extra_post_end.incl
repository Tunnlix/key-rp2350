/* Override only core-0 stack symbols after the SDK's libc/TLS definitions. */
SECTIONS
{
    __StackTop = ORIGIN(CTAP_STACK) + LENGTH(CTAP_STACK);
    __StackBottom = __StackTop - SIZEOF(.stack_dummy);
    __stack = __StackTop;
    ASSERT(SIZEOF(.stack_dummy) == LENGTH(CTAP_STACK), "unexpected CTAP stack reservation")
    __ctap_blob_start = ORIGIN(CTAP_BLOBS);
    __ctap_blob_end = ORIGIN(CTAP_BLOBS) + LENGTH(CTAP_BLOBS);
    ASSERT(LENGTH(FLASH) == 748K, "unexpected A/B slot capacity")
    ASSERT(__ctap_blob_end == __ctap_store_start, "blob/store layout gap or overlap")
    ASSERT(__flash_binary_end <= ORIGIN(FLASH) + LENGTH(FLASH), "firmware exceeds A/B slot")
}
