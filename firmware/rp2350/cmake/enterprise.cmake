set(RP2350_ENTERPRISE_IDENTITY_DIR "" CACHE PATH "Separate enterprise attestation identity directory (never signing credentials)")
option(RP2350_ENTERPRISE_ALLOW_TEST_IDENTITY "Explicitly allow an isolated TEST ONLY attestation identity" OFF)
if(RP2350_ENTERPRISE_IDENTITY_DIR)
    if(NOT CTAP_MESSAGE_CAPACITY OR CTAP_MESSAGE_CAPACITY LESS 2048)
        message(FATAL_ERROR "Enterprise x5c replies require -DCTAP_MESSAGE_CAPACITY=2048")
    endif()
    set(RP2350_ENTERPRISE_PYTHON "" CACHE FILEPATH "Python interpreter with cryptography for identity validation")
    if(NOT RP2350_ENTERPRISE_PYTHON)
        find_package(Python3 REQUIRED COMPONENTS Interpreter)
        set(RP2350_ENTERPRISE_PYTHON "${Python3_EXECUTABLE}")
    endif()
    get_filename_component(enterprise_repo "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
    set(enterprise_generated "${CMAKE_CURRENT_BINARY_DIR}/enterprise-private")
    file(MAKE_DIRECTORY "${enterprise_generated}")
    file(CHMOD "${enterprise_generated}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    set(test_identity_argument)
    if(RP2350_ENTERPRISE_ALLOW_TEST_IDENTITY)
        set(test_identity_argument --allow-test-identity)
    endif()
    execute_process(COMMAND "${RP2350_ENTERPRISE_PYTHON}" "${enterprise_repo}/tools/enterprise-identity.py" compile
        "${RP2350_ENTERPRISE_IDENTITY_DIR}" "${enterprise_generated}/enterprise_identity_private.h" ${test_identity_argument}
        RESULT_VARIABLE identity_result OUTPUT_VARIABLE identity_message ERROR_VARIABLE identity_error)
    if(NOT identity_result EQUAL 0)
        message(FATAL_ERROR "Enterprise identity validation failed: ${identity_error}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${enterprise_repo}/tools/enterprise-identity.py" "${RP2350_ENTERPRISE_IDENTITY_DIR}/identity.json"
        "${RP2350_ENTERPRISE_IDENTITY_DIR}/attestation-private.pem" "${RP2350_ENTERPRISE_IDENTITY_DIR}/attestation.pem"
        "${RP2350_ENTERPRISE_IDENTITY_DIR}/lab-ca.pem")
    target_include_directories(rp2350_storage_codec PRIVATE "${enterprise_generated}")
    target_compile_definitions(rp2350_storage_codec PRIVATE RP2350_ENTERPRISE_IDENTITY=1)
endif()

set(RP2350_BATCH_IDENTITY_DIR "" CACHE PATH "Optional ordinary batch attestation identity (separate from enterprise)")
option(RP2350_BATCH_ALLOW_TEST_IDENTITY "Explicitly allow a TEST ONLY ordinary batch identity" OFF)
if(RP2350_BATCH_IDENTITY_DIR)
    if(NOT CTAP_MESSAGE_CAPACITY OR CTAP_MESSAGE_CAPACITY LESS 2048)
        message(FATAL_ERROR "Batch x5c replies require -DCTAP_MESSAGE_CAPACITY=2048")
    endif()
    set(RP2350_ENTERPRISE_PYTHON "" CACHE FILEPATH "Python interpreter with cryptography for identity validation")
    if(NOT RP2350_ENTERPRISE_PYTHON)
        find_package(Python3 REQUIRED COMPONENTS Interpreter)
        set(RP2350_ENTERPRISE_PYTHON "${Python3_EXECUTABLE}")
    endif()
    get_filename_component(attestation_repo "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
    set(batch_generated "${CMAKE_CURRENT_BINARY_DIR}/batch-private")
    file(MAKE_DIRECTORY "${batch_generated}")
    file(CHMOD "${batch_generated}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    set(batch_arguments --batch)
    if(RP2350_BATCH_ALLOW_TEST_IDENTITY)
        list(APPEND batch_arguments --allow-test-identity)
    endif()
    if(RP2350_ENTERPRISE_IDENTITY_DIR)
        list(APPEND batch_arguments --distinct-from "${RP2350_ENTERPRISE_IDENTITY_DIR}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${RP2350_ENTERPRISE_IDENTITY_DIR}/attestation.pem")
    endif()
    execute_process(COMMAND "${RP2350_ENTERPRISE_PYTHON}" "${attestation_repo}/tools/enterprise-identity.py" compile
        "${RP2350_BATCH_IDENTITY_DIR}" "${batch_generated}/batch_identity_private.h" ${batch_arguments}
        RESULT_VARIABLE batch_result OUTPUT_VARIABLE batch_message ERROR_VARIABLE batch_error)
    if(NOT batch_result EQUAL 0)
        message(FATAL_ERROR "Ordinary batch identity validation failed: ${batch_error}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${attestation_repo}/tools/enterprise-identity.py" "${RP2350_BATCH_IDENTITY_DIR}/identity.json"
        "${RP2350_BATCH_IDENTITY_DIR}/attestation-private.pem" "${RP2350_BATCH_IDENTITY_DIR}/attestation.pem"
        "${RP2350_BATCH_IDENTITY_DIR}/lab-ca.pem")
    target_include_directories(rp2350_storage_codec PRIVATE "${batch_generated}")
    target_compile_definitions(rp2350_storage_codec PRIVATE RP2350_BATCH_IDENTITY=1)
endif()
