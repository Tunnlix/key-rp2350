# Executable and build directories
/build/
/out/
/cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CMakeUserPresets.json
# Local tooling configuration and work notes.
/AGENTS.md
/development/ai/
/development/
/tests/
/diagnostics/
/.codex/
/.claude/
/CLAUDE.md
# Ignored local tooling remnants are not dependencies of the portable build.
/.venv/
__pycache__/
*.pyc

# Compiled objects, dependency files, and libraries
*.o
*.d
*.a
*.so
*.so.*
*.dll
*.exe
*.elf
*.uf2
*.bin
*.hex
*.map
*.dis
*.su

# Local device captures and private provisioning/release material.
/device-dumps/
/secrets/
/releases/
*.pem
*.key

# Debugging and profiling output
/core
/core.*
*.gcda
*.gcno
*.gcov
gmon.out

# Editor temporary files and OS metadata
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Keep .vscode configuration tracked for shared build/debug setup.

# Keep mutable project planning outside the public repository.
/docs/*
!/docs/third-party-notices.md
!/docs/building.md
!/docs/pin-policy.md
